# Use this network's public hosts, RPC, branding and parent-chain settings.
# Compose supplies NEXT_PUBLIC_NETWORK_ID and NEXT_PUBLIC_IS_TESTNET.
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_HOST=
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
NEXT_PUBLIC_NETWORK_NAME=
NEXT_PUBLIC_NETWORK_SHORT_NAME=
NEXT_PUBLIC_NETWORK_RPC_URL=
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_STATS_API_HOST=
NEXT_PUBLIC_STATS_API_BASE_PATH=/statsapi
NEXT_PUBLIC_VISUALIZE_API_HOST=
NEXT_PUBLIC_VISUALIZE_API_BASE_PATH=/visualizerapi
# The selected v2.7.2 image generates its own icon-sprite hash.
# Retired NEXT_PUBLIC_API_SPEC_URL / NEXT_PUBLIC_ROLLUP_L1_BASE_URL are omitted.
