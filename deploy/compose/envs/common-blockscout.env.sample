# Copy this network's existing settings here, including its bridge/L1 settings.
# CHAIN_ID, CHAIN_TYPE and the release identity come from Compose and .env.
DATABASE_URL=
SECRET_KEY_BASE=
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_HTTP_URL=
ETHEREUM_JSONRPC_TRACE_URL=
ETHEREUM_JSONRPC_WS_URL=
ETHEREUM_JSONRPC_RECEIPTS_BY_BLOCK=false
PORT=4000
NETWORK=
SUBNETWORK=
COIN_NAME=
COIN=
POOL_SIZE=40
POOL_SIZE_API=20
ECTO_USE_SSL=false
# Retain each network's reviewed history ranges; do not copy the devnet cutoff.
TRACE_BLOCK_RANGES=
INDEXER_UNCATALOGED_TOKEN_TRANSFERS_ENABLED=false
NFT_MEDIA_HANDLER_ENABLED=true
NFT_MEDIA_HANDLER_REMOTE_DISPATCHER_NODE_MODE_ENABLED=true
RELEASE_NODE=producer@backend.blockscout.internal
RELEASE_DISTRIBUTION=name
RELEASE_COOKIE=
ACCOUNT_REDIS_URL=redis://redis-db:6379
MICROSERVICE_SC_VERIFIER_TYPE=sc_verifier
MICROSERVICE_SC_VERIFIER_URL=http://sc-verifier:8050
MICROSERVICE_SIG_PROVIDER_ENABLED=true
MICROSERVICE_SIG_PROVIDER_URL=http://sig-provider:8050
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=true
MICROSERVICE_VISUALIZE_SOL2UML_URL=http://visualizer:8050
MICROSERVICE_ACCOUNT_ABSTRACTION_ENABLED=true
MICROSERVICE_ACCOUNT_ABSTRACTION_URL=http://user-ops-indexer:8050
