# Devnet only. For an existing stack, retain its exact project and network names.
COMPOSE_PROJECT_NAME=deriw-dev
NETWORK_NAME=deriw-dev_default
CHAIN_ID=18417507517
IS_TESTNET=true

# Set the source SHA and release image. The worker normally shares that image.
BLOCKSCOUT_VERSION=
BACKEND_IMAGE=deriw-blockscout:dev-v10.2.6
NFT_MEDIA_HANDLER_IMAGE=${BACKEND_IMAGE}
FRONTEND_IMAGE=quanquanah/blockscout-frontend@sha256:44bd15d39c839baf1e32e28ce99c63c9eee99db8e08043cc0df8ceb1d84faf28

# Retain this server's selected infrastructure/service images, preferably digests.
POSTGRES_IMAGE=
STATS_POSTGRES_IMAGE=
REDIS_IMAGE=
NGINX_IMAGE=
STATS_IMAGE=
VISUALIZER_IMAGE=
SIG_PROVIDER_IMAGE=
SMART_CONTRACT_VERIFIER_IMAGE=
USER_OPS_INDEXER_IMAGE=

# Existing absolute host paths. Compose will not create missing bind directories.
BLOCKSCOUT_DB_DATA_DIR=
STATS_DB_DATA_DIR=
REDIS_DATA_DIR=
BACKEND_LOG_DIR=
BACKEND_DETS_DIR=
NGINX_CONFIG_DIR=
NGINX_CONFIG_TARGET=/etc/nginx/templates
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
