# Testnet only. Keep the actual existing project/network names during adoption.
COMPOSE_PROJECT_NAME=deriw-test
NETWORK_NAME=deriw-test_default
CHAIN_ID=
IS_TESTNET=true

# Promote the tested backend image by digest when deploying an existing release.
BLOCKSCOUT_VERSION=
BACKEND_IMAGE=deriw-blockscout:test-v10.2.6
NFT_MEDIA_HANDLER_IMAGE=${BACKEND_IMAGE}
FRONTEND_IMAGE=quanquanah/blockscout-frontend@sha256:44bd15d39c839baf1e32e28ce99c63c9eee99db8e08043cc0df8ceb1d84faf28

POSTGRES_IMAGE=
STATS_POSTGRES_IMAGE=
REDIS_IMAGE=
NGINX_IMAGE=
STATS_IMAGE=
VISUALIZER_IMAGE=
SIG_PROVIDER_IMAGE=
SMART_CONTRACT_VERIFIER_IMAGE=
USER_OPS_INDEXER_IMAGE=

# Fill these from the existing testnet installation, not from devnet.
BLOCKSCOUT_DB_DATA_DIR=
STATS_DB_DATA_DIR=
REDIS_DATA_DIR=
BACKEND_LOG_DIR=
BACKEND_DETS_DIR=
NGINX_CONFIG_DIR=
NGINX_CONFIG_TARGET=/etc/nginx/templates
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
